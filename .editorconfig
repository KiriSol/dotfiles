[*]
charset = utf-8
end_of_line = lf
indent_size = 2
indent_style = space
insert_final_newline = true
tab_width = 4
trim_trailing_whitespace = true

## Changes

[*.md]
trim_trailing_whitespace = false

[*.{fish,nu,nuon}]
indent_size = 4

[{justfile,*.just}]
indent_size = 4

[*.kdl]
indent_size = 4

[{.git{attributes,config,ignore,modules},src/config/git/{attributes,config,ignore}}]
indent_size = 4
indent_style = tab

## Tools

# Shfmt
[*.{sh,bash}]
binary_next_line = true
space_redirects = true
switch_case_indent = true
